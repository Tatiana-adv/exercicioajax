// Exemplo de como a função sendDataToServer seria com XMLHttpRequest
function sendDataToServerXHR(data) {
    return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', 'https://sua-api.com/register', true);
        xhr.setRequestHeader('Content-Type', 'application/json');

        xhr.onload = function() {
            if (xhr.status >= 200 && xhr.status < 300) {
                resolve(JSON.parse(xhr.responseText));
            } else {
                reject(new Error(`Erro do servidor: ${xhr.statusText}`));
            }
        };

        xhr.onerror = function() {
            reject(new Error('Erro de conexão de rede.'));
        };

        xhr.send(JSON.stringify(data));
    });
}
